{
  "name": "ee-site-design",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test lib/rules.test.js lib/embed-plant.test.js lib/pond-hydrology.test.js lib/abmi-lidar.test.js lib/surface-water.test.js lib/canopy.test.js",
    "export-crops": "node scripts/export-farmfit-crops.mjs",
    "ingest:land-value": "node scripts/ingest-land-value.mjs",
    "ingest:land-value:calgary": "node scripts/ingest-land-value.mjs calgary --max-tiles 30",
    "ingest:land-value:edmonton": "node scripts/ingest-land-value.mjs edmonton --max-tiles 30",
    "scrape:vendors": "node scripts/scrape-vendor-catalogs.mjs",
    "pfaf:download": "node scripts/download-pfaf-db.mjs",
    "enrich:plant-specs": "node scripts/enrich-plant-specs.mjs",
    "enrich:plant-specs:curated": "node scripts/enrich-plant-specs.mjs --curated-only --limit 120 --force",
    "satellite": "node scripts/satellite-indices.mjs",
    "satellite:demo": "node scripts/satellite-indices.mjs --lat 53.80 --lng -113.65"
  },
  "dependencies": {
    "express": "^4.19.2",
    "geotiff": "^3.0.5"
  }
}
