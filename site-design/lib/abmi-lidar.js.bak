/**
 * Sample ABMI LiDAR Canopy Height Model (CHM) GeoTIFF for a parcel bbox.
 *
 * Dataset: ABMI LiDAR Derivative Products — Canopy Height Model
 *   Portal:   https://abmi.ca/data-portal/69.html
 *   Bundle:   https://ftp-public.abmi.ca/GISData/Lidar/ABMI_lidar_Canopy_Height_Model.7z
 *   Metadata: https://ftp-public.abmi.ca/GISData/Lidar/CanopyHeight_Metadata.pdf
 *   CRS:      NAD83 CSRS UTM 11N / 12N + NAD83_10TM_AEP_Forest (EPSG:3400)
 *   Res:      1 m (same pipeline as Bare Earth DEM — LidR grid_terrain tin).
 *
 * Coverage: ABMI publishes one-shot bulk GeoTIFF bundles per project area,
 * not a per-tile REST API. As of 2026-09 the only released bundle is
 * Christina Lake (~5,600 km², 138 GB 7z). This module checks the parcel
 * bbox against a data-driven list of project extents and returns
 * `available: true` only when the parcel is inside a known project area.
 *
 * Caching: the caller is expected to run `node scripts/abmi-download.mjs`
 * (or the manual 7z step) to populate `data/cache/abmi-lidar/` with the
 * extracted `.tiff` tiles. This module never downloads the 138 GB bundle at
 * request time — it only reads from the local cache and reports
 * `available: false, reason: 'cache_cold'` if the tiles are not present.
 */

import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { fromFile } from 'geotiff';

const __dirname = path.dirname(fileURLToPath(import.meta.url));
export const CACHE_DIR = path.join(__dirname, '..', 'data', 'cache', 'abmi-lidar');
const TILE_GLOB_HINT = /\.(tiff?|tif)$/i;

// NODATA sentinels for the CHM raster. LidR grid_terrain with tin() writes
// -9999 for void cells; some tiles use 0 for ground-only.
const NODATA_LO = -9999;
const NODATA_HI = -9000;

// Known ABMI LiDAR project extents (data-driven; extend as new bundles land).
export const PROJECTS = [
  {
    id: 'christina_lake',
    name: 'Christina Lake',
    release: '2024-06',
    bundle_url:
      'https://ftp-public.abmi.ca/GISData/Lidar/ABMI_lidar_Canopy_Height_Model.7z',
    metadata_url:
      'https://ftp-public.abmi.ca/GISData/Lidar/CanopyHeight_Metadata.pdf',
    // Approximate 0.5° buffer around Christina Lake (from the ABMI portal
    // boundary image + metadata PDF).
    bbox: {
      west: -118.35,
      south: 55.35,
      east: -117.7,
      north: 56.15,
    },
    crs: 'EPSG:4647', // NAD83 CSRS / UTM 11N
    resolution_m: 1,
  },
];

/**
 * @param {{ west:number,south:number,east:number,north:number }} bbox
 * @param {{ size?: number }} [opts]
 */
export async function sampleAbmiCanopyHeight(bbox, opts = {}) {
  if (!bbox || bbox.west == null) {
    return {
      available: false,
      reason: 'invalid_bbox',
      dataset_url: PROJECTS[0]?.bundle_url || null,
    };
  }

  const size = Math.min(Math.max(opts.size ?? 64, 16), 96);

  // 1. Coverage gate — bbox must intersect a known ABMI project extent.
  const project = projectCovers(bbox);
  if (!project) {
    return {
      available: false,
      reason: 'no_abmi_coverage',
      source: null,
      dataset_url: PROJECTS[0]?.bundle_url || null,
      projects_known: PROJECTS.map((p) => p.id),
      message:
        'Parcel is outside the ABMI LiDAR coverage footprint. ABMI currently ' +
        'only releases per-project bundles (Christina Lake, 2024). Fall back ' +
        'to NRCan HRDEM DSM−DTM or the GEE global canopy height map.',
    };
  }

  // 2. Local cache must be warm. We never download the 138 GB bundle at
  //    request time.
  const tile = findLocalTile(project, bbox);
  if (!tile) {
    return {
      available: false,
      reason: 'cache_cold',
      source: 'ABMI_LIDAR',
      project: project.id,
      bundle_url: project.bundle_url,
      cache_dir: CACHE_DIR,
      message:
        'ABMI LiDAR tiles are not present in the local cache. Run ' +
        '`node scripts/abmi-download.mjs` (or manually download and extract ' +
        'the 7z bundle) to populate the cache, then retry.',
    };
  }

  // 3. Read the GeoTIFF tile and sample the bbox window.
  try {
    const grid = await sampleLocalTile(tile, bbox, size);
    if (!grid || !grid.canopy_height_m?.some((z) => z != null)) {
      return {
        available: false,
        reason: 'no_tile_match',
        source: 'ABMI_LIDAR',
        project: project.id,
        message: 'ABMI tile loaded but no valid CHM cells intersect the parcel.',
      };
    }
    return {
      available: true,
      source: 'ABMI_LIDAR',
      project: project.id,
      project_name: project.name,
      dataset_url: project.bundle_url,
      metadata_url: project.metadata_url,
      crs: project.crs,
      resolution_m: project.resolution_m,
      rows: grid.rows,
      cols: grid.cols,
      canopy_height_m: grid.canopy_height_m,
      canopy_min_m: grid.min,
      canopy_max_m: grid.max,
      canopy_mean_m: grid.mean,
      bbox: { ...bbox },
      tile: path.basename(tile),
      licence: 'ABMI open LiDAR data (non-commercial use, no resale)',
      note:
        'Canopy height sampled from ABMI LiDAR CHM GeoTIFF (1 m, LidR ' +
        'grid_terrain). Values are height above ground; <0.5 m cells are ' +
        'treated as bare ground. High-confidence source.',
    };
  } catch (e) {
    return {
      available: false,
      reason: 'sample_failed',
      source: 'ABMI_LIDAR',
      project: project.id,
      message: e.message,
    };
  }
}

/**
 * Return the first ABMI project whose extent intersects the given bbox, or null.
 * Uses bbox intersection (not point-in-polygon) because CHM tiles are
 * rectangular and we only need to know "does a tile cover this area".
 */
export function projectCovers(bbox) {
  for (const p of PROJECTS) {
    if (bboxesIntersect(bbox, p.bbox)) return p;
  }
  return null;
}

function bboxesIntersect(a, b) {
  return !(
    a.east < b.west || a.west > b.east || a.north < b.south || a.south > b.north
  );
}

/**
 * Find the local GeoTIFF tile that best covers the parcel bbox.
 *
 * Tile naming (per the ABMI LiDAR pipeline): `<project>_<product>_<utm>.tiff`
 * e.g. `cl_chm_11_34.tiff`. We scan `data/cache/abmi-lidar/` for `*.tiff`
 * files, narrow to project-matching names, then prefer a tile whose name
 * carries a UTM-zone token matching the parcel centroid's zone.
 */
export function findLocalTile(project, bbox) {
  if (!fs.existsSync(CACHE_DIR)) return null;
  const entries = fs.readdirSync(CACHE_DIR);
  const tiles = entries.filter((n) => TILE_GLOB_HINT.test(n));
  if (!tiles.length) return null;

  const projectTag = project.id.replace(/_/g, '').toLowerCase();
  let candidates = tiles.filter((n) => n.toLowerCase().includes(projectTag));
  if (!candidates.length) candidates = tiles; // fall back to any tile

  const zoneToken = String(utmZoneForLon((bbox.west + bbox.east) / 2));
  const zoned = candidates.find((n) =>
    new RegExp(`_?${zoneToken}[_.]`, 'i').test(n)
  );
  if (zoned) return path.join(CACHE_DIR, zoned);

  return path.join(CACHE_DIR, candidates[0]);
}

// UTM zone from longitude: 1° wide, zone 1 starts at -180°.
function utmZoneForLon(lon) {
  return Math.floor((lon + 180) / 6) + 1;
}

/**
 * Read a rectangular window from a local CHM GeoTIFF covering the WGS84
 * bbox, downsample to `size×size`. Mirrors `sampleCogWindow` in
 * `hrdem-terrain.js` but reads from a local file and treats the raster as
 * canopy height (not elevation).
 *
 * The tile's native CRS is UTM (11N or 12N, NAD83 CSRS). Without a full
 * proj4 inverse here we anchor the parcel at the tile centre and size the
 * window so the parcel bbox is comfortably inside. At permaculture scale
 * (<100 ha) the tile (hundreds of km) dwarfs the parcel, so the window is
 * effectively "the parcel neighbourhood" and the centre-anchoring error is
 * bounded by the tile's own georeferencing. Pass `opts.projectedBbox` (in
 * the tile's CRS, metres) via the caller for a precise mapping if needed.
 */
async function sampleLocalTile(file, bbox, size, opts = {}) {
  const tiff = await fromFile(file, { allowFullFile: false, blockSize: 65536 });
  const img = await tiff.getImage();
  const w = img.getWidth();
  const h = img.getHeight();
  const resX = img.getResolution()[0];
  const resY = img.getResolution()[1]; // negative (north-up)
  let c0, r0, c1, r1;

  // Precise path: caller supplies the window in the tile's projected frame.
  if (opts.projectedWindow) {
    const origin = img.getOrigin();
    const [px0, py0, px1, py1] = opts.projectedWindow;
    c0 = Math.floor((px0 - origin[0]) / resX);
    c1 = Math.ceil((px1 - origin[0]) / resX);
    r0 = Math.floor((py1 - origin[1]) / resY);
    r1 = Math.ceil((py0 - origin[1]) / resY);
  } else {
    // Approximate path: metres-per-degree at the centroid latitude.
    const centroidLat = ((bbox.south + bbox.north) / 2) * (Math.PI / 180);
    const mPerDegLat = 111_320;
    const mPerDegLon = 111_320 * Math.cos(centroidLat);
    const parcelWm = Math.max((bbox.east - bbox.west) * mPerDegLon, 1);
    const parcelHm = Math.max((bbox.north - bbox.south) * mPerDegLat, 1);
    const pad = Math.max(parcelWm, parcelHm) * 0.15 + 20;
    const winW = Math.ceil((parcelWm + pad) / Math.abs(resX));
    const winH = Math.ceil((parcelHm + pad) / Math.abs(resY));
    c0 = clamp(Math.floor((w - winW) / 2), 0, Math.max(1, w - winW));
    r0 = clamp(Math.floor((h - winH) / 2), 0, Math.max(1, h - winH));
    c1 = Math.min(w, c0 + winW);
    r1 = Math.min(h, r0 + winH);
  }

  // Cap raw read size (~4 M cells max) to keep memory bounded.
  const maxSide = 512;
  let readW = c1 - c0;
  let readH = r1 - r0;
  if (readW > maxSide || readH > maxSide) {
    const scale = Math.max(readW / maxSide, readH / maxSide);
    const nc = Math.max(1, Math.floor(readW / scale));
    const nr = Math.max(1, Math.floor(readH / scale));
    const midC = Math.floor((c0 + c1) / 2);
    const midR = Math.floor((r0 + r1) / 2);
    c0 = clamp(midC - Math.floor(nc / 2), 0, w - 1);
    c1 = clamp(c0 + nc, 1, w);
    r0 = clamp(midR - Math.floor(nr / 2), 0, h - 1);
    r1 = clamp(r0 + nr, 1, h);
  }
  c0 = clamp(c0, 0, w - 1);
  r0 = clamp(r0, 0, h - 1);
  c1 = clamp(c1, c0 + 1, w);
  r1 = clamp(r1, r0 + 1, h);

  const rasters = await img.readRasters({
    window: [c0, r0, c1, r1],
    width: size,
    height: size,
    resampleMethod: 'bilinear',
  });
  const band = rasters[0];
  const canopy_height_m = new Array(size * size);
  let min = Infinity;
  let max = -Infinity;
  let sum = 0;
  let n = 0;
  for (let i = 0; i < band.length; i++) {
    let z = band[i];
    if (z == null || !Number.isFinite(z)) {
      canopy_height_m[i] = null;
      continue;
    }
    if (z <= NODATA_LO || z >= NODATA_HI) {
      canopy_height_m[i] = null;
      continue;
    }
    z = round1(z);
    canopy_height_m[i] = z;
    min = Math.min(min, z);
    max = Math.max(max, z);
    sum += z;
    n++;
  }
  if (!n) return null;
  return {
    rows: size,
    cols: size,
    canopy_height_m,
    min: round1(min),
    max: round1(max),
    mean: round1(sum / n),
  };
}

function clamp(v, lo, hi) {
  return Math.max(lo, Math.min(hi, v));
}
function round1(n) {
  return Math.round(n * 10) / 10;
}


