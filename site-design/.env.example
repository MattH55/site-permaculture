# Copy to .env and fill in (never commit .env)
RESEND_API_KEY=

# Where Resend actually delivers (must be allowed by Resend — often your Gmail until domain verified)
INQUIRY_TO=matt.halma@gmail.com
# Public EE address mentioned in the message body (optional; for forwarding / branding)
INQUIRY_PUBLIC_TO=info@expandingedge.ca
RESEND_FALLBACK_TO=matt.halma@gmail.com

# After verifying domain in Resend:
# INQUIRY_TO=info@expandingedge.ca
# INQUIRY_FROM=Expanding Edge <noreply@expandingedge.ca>
INQUIRY_FROM=Expanding Edge Site Design <onboarding@resend.dev>
GOOGLE_MAPS_API_KEY=

# NASA GPM PPS — registered email is both username and password
# https://registration.pps.eosdis.nasa.gov/registration/
# https://arthurhouhttps.pps.eosdis.nasa.gov/
GPM_PPS_EMAIL=
